# Copy to .env and fill in, or generate it from Terraform:
#
#   cd infra/core
#   terraform output    (see the guide for the one-liner)
#
# .env is gitignored - it holds account-specific values, not secrets.

AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=cloudmart-products
SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/cloudmart-orders
